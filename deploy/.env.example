# Public hostname (apex only, e.g. launchdesk.example.com)
DOMAIN=example.com

# Postgres (used by the postgres container and backend)
POSTGRES_PASSWORD=change-me-long-random-password

PORT=4000
NODE_ENV=production

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=launchdesk
DATABASE_PASSWORD=change-me-long-random-password
DATABASE_NAME=launchdesk

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

FRONTEND_URL=https://example.com

# Server-side URL for the Next.js BFF (Docker network)
API_URL=http://backend:4000

# Baked into the frontend image at build time
NEXT_PUBLIC_SITE_URL=https://example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM=LaunchDesk <noreply@example.com>
REPORT_EMAIL=reports@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.example.com/api/auth/github/callback

AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
